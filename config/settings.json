{
  "app": {
    "name": "Smart Indian Investment Research & Wealth Dashboard",
    "currency": "INR",
    "defaultCapital": 9000,
    "defaultMonthlySip": 0,
    "defaultHorizonYears": 10,
    "horizonOptions": [
      5,
      7,
      10
    ],
    "defaultScenario": "m",
    "defaultInflationPct": 5,
    "defaultProfile": "balanced",
    "maxFundsForSmallCapital": 4,
    "smallCapitalThreshold": 50000
  },
  "scenarios": {
    "c": {
      "label": "Conservative",
      "description": "Below long-run averages; e.g. a poor decade for equities."
    },
    "m": {
      "label": "Moderate",
      "description": "Roughly long-run Indian averages after a full market cycle."
    },
    "o": {
      "label": "Optimistic",
      "description": "Above-average decade. Do not plan around this."
    }
  },
  "scenarioNote": "Scenario returns are USER-EDITABLE ASSUMPTIONS of the fund's portfolio return BEFORE its expense ratio. They are not forecasts and are not derived from any single fund's past CAGR. The fund's expense ratio is subtracted to get the NAV return.",
  "profiles": {
    "conservative": {
      "label": "Conservative",
      "summary": "Capital safety first; ~50% equity, rest in low-volatility debt/arbitrage and gold.",
      "sleeves": [
        {
          "id": "core",
          "label": "Core large-cap equity",
          "categories": [
            "index_largecap"
          ],
          "pct": 35
        },
        {
          "id": "diverse",
          "label": "Diversified equity",
          "categories": [
            "index_broad",
            "flexi"
          ],
          "pct": 15
        },
        {
          "id": "stability",
          "label": "Stability sleeve",
          "categories": [
            "gilt",
            "debt_corporate",
            "arbitrage"
          ],
          "pct": 35,
          "fallbackTo": "core"
        },
        {
          "id": "gold",
          "label": "Gold diversifier",
          "categories": [
            "gold_fof",
            "gold_etf"
          ],
          "pct": 15,
          "fallbackTo": "stability"
        }
      ]
    },
    "balanced": {
      "label": "Balanced",
      "summary": "~65% equity for growth, with stability and gold sleeves to soften drawdowns.",
      "sleeves": [
        {
          "id": "core",
          "label": "Core large-cap equity",
          "categories": [
            "index_largecap"
          ],
          "pct": 40
        },
        {
          "id": "diverse",
          "label": "Diversified equity",
          "categories": [
            "flexi",
            "index_broad"
          ],
          "pct": 25
        },
        {
          "id": "stability",
          "label": "Stability sleeve",
          "categories": [
            "gilt",
            "debt_corporate",
            "arbitrage"
          ],
          "pct": 20,
          "fallbackTo": "core"
        },
        {
          "id": "gold",
          "label": "Gold diversifier",
          "categories": [
            "gold_fof",
            "gold_etf"
          ],
          "pct": 15,
          "fallbackTo": "core"
        }
      ]
    },
    "growth": {
      "label": "Growth",
      "summary": "~85% equity incl. mid/small caps; expect deep interim falls. Only for 7–10+ year money.",
      "sleeves": [
        {
          "id": "core",
          "label": "Core large-cap equity",
          "categories": [
            "index_largecap"
          ],
          "pct": 35
        },
        {
          "id": "diverse",
          "label": "Diversified equity",
          "categories": [
            "flexi",
            "index_broad"
          ],
          "pct": 30
        },
        {
          "id": "satellite",
          "label": "Mid/small-cap satellite",
          "categories": [
            "midcap",
            "smallcap"
          ],
          "pct": 20,
          "fallbackTo": "diverse"
        },
        {
          "id": "gold",
          "label": "Gold diversifier",
          "categories": [
            "gold_fof",
            "gold_etf"
          ],
          "pct": 15,
          "fallbackTo": "core"
        }
      ]
    }
  },
  "selectionRules": {
    "excludeIfHorizonBelowCategoryMinHold": true,
    "requireVerifiedMinimum": true,
    "requireMinHistoryYears": 3,
    "preferLowerTaxDragForStabilityWhenSlabAbove": 20,
    "roundAmountsTo": 100
  },
  "scoring": {
    "note": "Each component is ranked against funds in the same asset class (equity / debt / gold / hybrid) and scaled 0–100. Missing data scores 50 (neutral) and is flagged. Past performance does not predict future returns.",
    "weights": {
      "consistency": 20,
      "riskAdjusted": 20,
      "downside": 15,
      "cost": 15,
      "scaleHistory": 15,
      "return": 15
    },
    "labels": {
      "consistency": "Consistency (rolling 3-yr CAGR: median & % of windows beating the risk-free proxy)",
      "riskAdjusted": "Risk-adjusted return (3-yr Sortino ratio)",
      "downside": "Downside control (5-yr maximum drawdown)",
      "cost": "Cost (expense ratio)",
      "scaleHistory": "Scale & track record (AUM and years of NAV history)",
      "return": "Long-run return (5-yr CAGR, else 3-yr)"
    }
  },
  "riskFree": {
    "proxySchemeCode": 143269,
    "proxyLabel": "Parag Parikh Liquid Fund (Direct) trailing 3-yr CAGR",
    "fallbackPct": 6,
    "note": "Sharpe/Sortino use the liquid fund's own trailing return as a risk-free proxy; if unavailable, the fallback assumption is used and flagged."
  },
  "correctionWindows": [
    {
      "id": "covid",
      "label": "COVID crash",
