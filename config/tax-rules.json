        ],
        "international_fof": [
          { "ltAfterMonths": 24,
            "st": { "kind": "slab", "rate": "slab", "section": "Slab" },
            "lt": { "kind": "otherLT", "rate": 12.5, "section": "112 (no indexation)" } }
        ],
        "listed_non_equity_etf": [
          { "ltAfterMonths": 12,
            "st": { "kind": "slab", "rate": "slab", "section": "Slab" },
            "lt": { "kind": "otherLT", "rate": 12.5, "section": "112 (no indexation)" } }
        ],
        "gsec_listed": [
